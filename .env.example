# Copy to .env. Leave everything empty to run in MOCK mode (rule-based extraction on the sample PDFs only).

# Option A - Anthropic API: the PDF goes straight to Claude, structured output.
ANTHROPIC_API_KEY=
PILOT_MODEL=claude-opus-5

# Option B - Anthropic-compatible endpoint (e.g. z.ai GLM coding plan). PDF text in, JSON out.
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=
# PILOT_MODEL=glm-5.3-flash

# Matching tolerance: relative amount difference that still counts as an automatic match.
PILOT_AMOUNT_TOLERANCE=0.01

# Optional SMTP for approval emails. Leave empty to log the email to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APPROVER_EMAIL=
